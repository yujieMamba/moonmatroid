  for pair in pairs {
    let result = intersect(models[pair[0]], models[pair[1]])
    verify_intersection(models[pair[0]], models[pair[1]], result)
    assert_eq(result.elements.length(), pair[2])
  }
  let unions = [
    [6, 33, 5],
    [46, 41, 6],
